: "<img src=\"manual/img/sys-monitor-native.png?v=2f6443d25d86\" width=\"752\" height=\"376\" alt=\"Resource monitor, page 1: the audio load split into instruments, envelopes, effects and the rest.\" loading=\"lazy\">", "149": "<img src=\"manual/img/sys-monitor-1-native.png?v=193e54e17024\" width=\"752\" height=\"376\" alt=\"Resource monitor, page 2: the instrument load split into synth, sampler and drum.\" loading=\"lazy\">", "150": "<img src=\"manual/img/sys-monitor-2-native.png?v=3fb75c8df5e5\" width=\"752\" height=\"376\" alt=\"Resource monitor, page 3: how many plugin files loaded and how many were refused.\" loading=\"lazy\">", "151": "<img src=\"manual/img/sys-monitor-3-native.png?v=810d4d926207\" width=\"752\" height=\"376\" alt=\"Resource monitor, page 4: the sound database status, DB OK.\" loading=\"lazy\">", "152": "<img src=\"manual/img/sys-monitor-4-native.png?v=5dc091c4b67f\" width=\"752\" height=\"376\" alt=\"Resource monitor, page 5: PK and the slowest audio block split into INST, ENV, FX and REST.\" loading=\"lazy\">", "153": "<img src=\"manual/img/sys-monitor-5-native.png?v=d5986467cfbd\" width=\"752\" height=\"376\" alt=\"Resource monitor, page 6: MIN GAP, the shortest gap between audio blocks.\" loading=\"lazy\">", "154": "<img src=\"manual/img/settings-opus.png?v=2d2b2a4bd810\" width=\"752\" height=\"376\" alt=\"The OPUS PLUGINS settings page: five rows, each with the plugin&#x27;s name in grey, the setting and its value. The MATRIX ENVELOPE CURVE row is selected: blue on a dark bar, its value EXPONENTIAL in orange.\" loading=\"lazy\">", "155": "<img src=\"manual/img/sys-settings-native.png?v=8112c3fed299\" width=\"752\" height=\"376\" alt=\"Settings page: COUNT-IN 4 in blue, MIDI SEQ OFF in green, STEFAN OFF in white and CLICK TONE in orange, with four page dots at the top right.\" loading=\"lazy\">", "156": "<img src=\"manual/img/sys-settings-shift-native.png?v=d01ecf6f1262\" width=\"752\" height=\"376\" alt=\"Settings page with Shift held: the title SETTINGS in blue between two arrows, the four rows dimmed.\" loading=\"lazy\">", "157": "<img src=\"manual/img/sys-settings-clickfx-native.png?v=48eb26571a66\" width=\"752\" height=\"376\" alt=\"Settings page: COUNT-IN 4, MIDI SEQ OFF, STEFAN OFF and CLICK WOOD FX in orange.\" loading=\"lazy\">", "158": "<img src=\"manual/img/com-midi-cc-native.png?v=e05101a2ec6a\" width=\"752\" height=\"376\" alt=\"The COM screen&#x27;s OP-1 tab with Shift held. The MIDI panel lists MIDI CH 01, KEYS CH 02 in green, PARAM CH 03 in white and FEEDBACK ON in red.\" loading=\"lazy\">", "159": "<img src=\"manual/img/clock-1.png?v=f24bc89c023d\" width=\"752\" height=\"376\" alt=\"An Oblique Strategies card\" loading=\"lazy\">"}